            "state": "translated",
            "value": "%lld%%"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%%"
          }
        }
      }
    },
    "Budget health unavailable": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Biudžeto būklė nepasiekiama"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác định tình trạng ngân sách"
          }
        }
      }
    },
    "Budgeted %@": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Biudžete numatyta %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lập ngân sách %@"
          }
        }
      }
    },
    "Budgets": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Biudžetai"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngân sách"
          }
        }
      }
    },
    "No budgets yet — set them on the phone or web.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Biudžetų dar nėra — nustatykite juos telefone arba žiniatinklyje."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có ngân sách — hãy thiết lập trên điện thoại hoặc web."
          }
        }
      }
    },
    "On track": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Viskas pagal planą"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đúng tiến độ"
          }
        }
      }
    },
    "Left to spend": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liko išleisti"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn để chi tiêu"
          }
        }
      }
    },
    "Safe to spend": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Saugu išleisti"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "An toàn để chi tiêu"
          }
        }
      }
    },
    "Net worth": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grynoji vertė"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị ròng"
          }
        }
      }
    },
    "Unavailable—1 stored amount could not be read.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepasiekiama — nepavyko perskaityti 1 išsaugotos sumos."
