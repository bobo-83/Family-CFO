    "Encrypted backups kept on the box (the last 7). Restoring replaces everything currently in the app.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Užšifruotos atsarginės kopijos, saugomos serveryje (paskutinės 7). Atkūrimas pakeičia viską, kas šiuo metu yra programėlėje."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu đã mã hóa được giữ trên máy (7 bản gần nhất). Khôi phục sẽ thay thế toàn bộ dữ liệu hiện có trong ứng dụng."
          }
        }
      }
    },
    "End conversation": {
      "localizations": {
        "lt": {
          "stringUnit": {
