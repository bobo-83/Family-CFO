          }
        }
      }
    },
    "Nothing to review — no possible duplicates, suspected income, transfers, or credits.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nėra ką peržiūrėti — nei galimų dublikatų, nei galimų pajamų, nei pervedimų ar kreditų."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì để xem xét — không có khoản trùng lặp, thu nhập nghi ngờ, chuyển khoản hay hoàn tiền."
          }
        }
      }
    },
    "Nothing to study yet — add or import transactions first.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kol kas nėra ko mokytis — pirma pridėkite arba importuokite operacijas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có gì để học — hãy thêm hoặc nhập giao dịch trước."
          }
        }
      }
    },
    "Number of payments remaining": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Likusių įmokų skaičius"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số kỳ trả còn lại"
