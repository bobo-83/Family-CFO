    ". Disputing tracks it here — contact your bank to actually dispute it.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": ". Ginčijimas čia tik pažymimas — kad iš tikrųjų užginčytumėte, kreipkitės į banką."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ". Khiếu nại chỉ ghi nhận ở đây — hãy liên hệ ngân hàng để khiếu nại thật sự."
          }
        }
      }
    },
