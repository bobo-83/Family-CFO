          }
        }
      }
    },
    "Paused — pick and enable an AI model on the web dashboard to resume.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pristabdyta — norėdami tęsti, žiniatinklio skydelyje pasirinkite ir įjunkite DI modelį."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tạm dừng — hãy chọn và bật một mô hình AI trên bảng điều khiển web để tiếp tục."
          }
        }
      }
    },
    "Paydays come from your recurring deposits; payments from the Bills timeline. Rows marked from statement are exact; the rest are estimates — a card without a statement shows today's balance, which may be lower than the final figure.": {
      "extractionState": "manual",
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atlyginimo dienos imamos iš pasikartojančių įplaukų; mokėjimai — iš sąskaitų laiko juostos. Eilutės, pažymėtos iš išrašo, yra tikslios; visos kitos yra tik įverčiai — kortelė be išrašo rodo šiandienos likutį, kuris gali būti mažesnis už galutinę sumą."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày lương lấy từ các khoản tiền vào định kỳ; các khoản chi lấy từ dòng thời gian Hóa đơn. Các dòng có nhãn từ sao kê là con số chính xác; phần còn lại là ước tính — thẻ chưa có sao kê hiển thị số dư hôm nay, có thể thấp hơn con số cuối cùng."
          }
        }
      }
    },
    "Payment per month": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mėnesio įmoka"
          }
        },
        "vi": {
