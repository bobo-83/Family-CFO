    "Households marked \"member sign-in needed\" can't be sealed until a member signs in with their password.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Namų ūkių, pažymėtų „reikia nario prisijungimo“, negalima užsandarinti, kol narys neprisijungia su savo slaptažodžiu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hộ gia đình được đánh dấu \"cần thành viên đăng nhập\" chưa thể niêm phong cho đến khi có thành viên đăng nhập bằng mật khẩu."
          }
        }
      }
    },
    "How it's calculated": {
      "localizations": {
