    },
    "No certificate fingerprint in this code — the app will require a CA-trusted certificate.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Šiame kode nėra sertifikato kontrolinio kodo — programėlė reikalaus CA patvirtinto sertifikato."
          }
        },
