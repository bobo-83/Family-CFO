            "value": "Atverti diegimo puslapį"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở trang cài đặt"
          }
        }
      }
    },
    "Opens your backup files.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atrakina jūsų atsarginių kopijų failus."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở các tệp sao lưu của bạn."
          }
        }
      }
    },
    "Optional note": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pastaba (nebūtina)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú (không bắt buộc)"
          }
        }
      }
    },
    "Optional — the days this cycle covers.": {
      "localizations": {
        "lt": {
          "stringUnit": {
