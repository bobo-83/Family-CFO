    "Educational guidance from a local AI — not financial, tax, or legal advice. It can be wrong; verify before acting.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mokomojo pobūdžio pagalba iš vietinio DI — ne finansinė, mokesčių ar teisinė konsultacija. Ji gali klysti; prieš imdamiesi veiksmų pasitikrinkite."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hướng dẫn mang tính giáo dục từ AI chạy tại chỗ — không phải lời khuyên tài chính, thuế hay pháp lý. Nó có thể sai; hãy kiểm chứng trước khi làm theo."
          }
        }
      }
    },
    "Email": {
      "localizations": {
