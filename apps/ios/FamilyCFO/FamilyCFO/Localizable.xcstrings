    "Could not reach the server: make sure this phone is on the same network (or tailnet) as your Family CFO box.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepavyko pasiekti serverio: įsitikinkite, kad šis telefonas yra tame pačiame tinkle (arba tailnet tinkle) kaip jūsų Family CFO serveris."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không kết nối được với máy chủ: hãy chắc chắn điện thoại này ở cùng mạng (hoặc tailnet) với máy Family CFO của bạn."
          }
