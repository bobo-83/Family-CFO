    },
    "Restoring onto a new box takes both keys — store them together in a password manager.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Norint atkurti į naują serverį, reikia abiejų raktų — laikykite juos kartu slaptažodžių tvarkyklėje."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục sang một máy mới cần cả hai khóa — hãy cất chung trong trình quản lý mật khẩu."
          }
