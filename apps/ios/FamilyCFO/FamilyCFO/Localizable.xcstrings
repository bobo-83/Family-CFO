    "Restored from %@. Reopen the app to see restored data.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atkurta iš %@. Iš naujo atidarykite programėlę, kad matytumėte atkurtus duomenis."
