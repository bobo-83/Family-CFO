    "Paid it off or added it by mistake? Deleting removes it from your debts and net worth.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Grąžinote ar pridėjote per klaidą? Ištrynus ji dings iš jūsų skolų ir grynosios vertės."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã trả hết hoặc thêm nhầm? Xóa sẽ gỡ nó khỏi phần nợ và giá trị ròng của bạn."
          }
