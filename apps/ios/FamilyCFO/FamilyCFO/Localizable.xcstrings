    "No %@ voice is installed on this iPhone — speech will use the English voice. Download one in Settings → Accessibility → Read & Speak → Voices.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Šiame iPhone nėra įdiegto %@ balso — bus kalbama anglišku balsu. Atsisiųskite jį per Nustatymai → Pritaikymas neįgaliesiems → Skaitymas ir kalbėjimas → Balsai."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có giọng %@ nào được cài trên iPhone này — phần đọc sẽ dùng giọng tiếng Anh. Hãy tải một giọng trong Cài đặt → Trợ năng → Đọc & Nói → Giọng nói."
          }
        }
      }
    },
    "No account to record this against yet — link a bank, or add one by hand on the Accounts tab.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kol kas nėra sąskaitos, kuriai tai priskirtumėte — susiekite banką arba rankiniu būdu pridėkite sąskaitą skirtuke „Sąskaitos“."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có tài khoản nào để ghi giao dịch này — hãy liên kết ngân hàng, hoặc thêm tài khoản thủ công ở thẻ Tài khoản."
          }
        }
      }
    },
    "No accounts": {
      "localizations": {
