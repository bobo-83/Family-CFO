    "Paste the QR payload below instead (shown under the QR on the dashboard).": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vietoj to žemiau įklijuokite QR turinį (jis rodomas po QR kodu skydelyje)."
          }
        },
        "vi": {
