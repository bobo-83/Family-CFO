    },
    "Already paid a bill? Swipe its row right to pick the charge that paid it.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jau apmokėjote sąskaitą? Perbraukite jos eilutę į dešinę ir pasirinkite nurašymą, kuriuo ji apmokėta."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã trả một hóa đơn rồi? Vuốt dòng đó sang phải để chọn khoản chi đã thanh toán nó."
          }
        }
      }
