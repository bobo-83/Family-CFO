            "value": "Tắt"
          }
        }
      }
    },
    "Off: shown beside Safe to Spend. On: subtracted like a bill.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Išjungta: rodoma šalia „Saugu išleisti“. Įjungta: atimama kaip sąskaita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt: hiển thị bên cạnh An toàn để chi tiêu. Bật: trừ ra như một hóa đơn."
          }
        }
      }
    },
    "On": {
      "localizations": {
        "lt": {
          "stringUnit": {
