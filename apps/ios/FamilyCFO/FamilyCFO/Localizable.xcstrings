    "Download everything in this household — accounts, transactions, advisor history, and documents — as a zip you can keep or take elsewhere.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atsisiųskite viską, kas yra šiame namų ūkyje — sąskaitas, operacijas, patarėjo istoriją ir dokumentus — kaip zip failą, kurį galite pasilikti arba perkelti kitur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải về mọi thứ trong hộ gia đình này — tài khoản, giao dịch, lịch sử cố vấn và tài liệu — dưới dạng tệp zip bạn có thể giữ lại hoặc mang đi nơi khác."
          }
        }
      }
    },
    "Download size": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atsisiuntimo dydis"
          }
        },
        "vi": {
