    "Away from home, connect through your household's own VPN or tailnet — the server is never exposed to the internet.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Būdami ne namuose, junkitės per savo namų ūkio VPN arba tailnet tinklą — serveris niekada nėra atviras internetui."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi ra khỏi nhà, hãy kết nối qua VPN hoặc tailnet riêng của hộ gia đình — máy chủ không bao giờ mở ra internet."
          }
        }
      }
    },
    "Back here: enter the Synology's IP, that folder name, the username and password, then tap Test connection.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Grįžę čia: įveskite Synology IP adresą, to aplanko pavadinimą, vartotojo vardą ir slaptažodį, tada bakstelėkite „Tikrinti ryšį“."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quay lại đây: nhập IP của Synology, tên thư mục đó, tên đăng nhập và mật khẩu, rồi chạm Kiểm tra kết nối."
          }
        }
      }
    },
