          }
        }
      }
    },
    "Vested RSUs · ready to sell": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suteiktos RSU · galima parduoti"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "RSU đã trao · sẵn sàng để bán"
          }
        }
      }
    },
    "Vested RSUs, ready to sell": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suteiktos RSU, galima parduoti"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "RSU đã trao, sẵn sàng để bán"
          }
        }
      }
    },
    "Vested company stock you could sell for cash — shown beside Safe to Spend, never added to it.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suteiktos bendrovės akcijos, kurias galėtumėte parduoti — rodomos šalia „Saugu išleisti“, niekada prie jos nepridedamos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cổ phiếu công ty đã trao mà bạn có thể bán lấy tiền mặt — hiển thị bên cạnh An toàn để chi tiêu, không bao giờ được cộng vào."
          }
        }
      }
    },
    "Vests over": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Įgyjama per"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trao quyền trong"
          }
        }
      }
    },
    "Vietnamese": {
      "localizations": {
        "lt": {
          "stringUnit": {
