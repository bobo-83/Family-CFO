    "No bills yet. Add one with +, or confirm a suggestion on the Bills tab.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sąskaitų kol kas nėra. Pridėkite su + arba patvirtinkite pasiūlymą Mokėtinų sąskaitų skiltyje."
          }
        },
        "vi": {
