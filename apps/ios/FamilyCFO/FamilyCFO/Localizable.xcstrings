    "No goals yet. Add one with + — an emergency fund, a vacation, a new car.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tikslų kol kas nėra. Pridėkite su + — rezervo fondas, atostogos, naujas automobilis."
          }
