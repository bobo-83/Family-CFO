    "Historical view of %@. “Right now” figures like safe-to-spend and upcoming bills only appear for the current month.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Istorinis %@ rodinys. „Dabartiniai“ skaičiai, tokie kaip „saugu išleisti“ ar artėjančios sąskaitos, rodomi tik einamajam mėnesiui."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ xem lịch sử của %@. Các số liệu “ngay lúc này” như an toàn để chi tiêu và hóa đơn sắp tới chỉ hiện cho tháng hiện tại."
          }
        }
      }
    },
    "Hourly": {
