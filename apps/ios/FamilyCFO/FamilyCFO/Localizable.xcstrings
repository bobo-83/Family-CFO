    "Reversible actions can be undone here at any time.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Grįžtamus veiksmus čia galima anuliuoti bet kada."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thao tác có thể đảo ngược đều hoàn tác được ở đây bất cứ lúc nào."
          }
        }
      }
    },
    "Review": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Peržiūra"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lại"
          }
        }
      }
    },
    "Review and undo past actions, back up to your Synology, and see every device paired to this household. Encrypted daily backups run automatically.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Peržiūrėkite ir anuliuokite ankstesnius veiksmus, kurkite atsargines kopijas į savo Synology ir matykite visus su šiuo namų ūkiu susietus įrenginius. Šifruotos atsarginės kopijos kuriamos automatiškai kasdien."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lại và hoàn tác các thao tác đã làm, sao lưu vào Synology của bạn, và xem mọi thiết bị đã ghép nối với hộ gia đình này. Bản sao lưu mã hóa chạy tự động hằng ngày."
          }
        }
      }
    },
    "Revoke": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Panaikinti"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu hồi"
          }
        }
      }
    },
