    "After a restart, nothing is readable — and overnight sync, snapshots, and study wait — until someone signs in.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Po perkrovimo niekas neįskaitoma — o naktinis sinchronizavimas, įrašai ir mokymasis laukia — kol kas nors prisijungs."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi khởi động lại, không gì đọc được — và đồng bộ ban đêm, ghi nhận số liệu, tự học đều phải chờ — cho đến khi có người đăng nhập."
          }
        }
      }
    },
    "All caught up — every transaction has a category.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viskas sutvarkyta — visos operacijos turi kategoriją."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong hết — mọi giao dịch đều đã có danh mục."
          }
        }
      }
    },
    "All clear": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viskas gerai"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có vấn đề"
          }
        }
      }
    },
    "Allow microphone and speech recognition in Settings to dictate. Audio never leaves this phone.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nustatymuose leiskite naudoti mikrofoną ir kalbos atpažinimą, kad galėtumėte diktuoti. Garsas niekada nepalieka šio telefono."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép micrô và nhận dạng giọng nói trong Cài đặt để đọc chính tả. Âm thanh không bao giờ rời khỏi điện thoại này."
          }
        }
      }
    },
    "Allow microphone and speech recognition in Settings to talk to your CFO. Audio never leaves this phone.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nustatymuose leiskite naudoti mikrofoną ir kalbos atpažinimą, kad galėtumėte kalbėtis su savo CFO. Garsas niekada nepalieka šio telefono."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép micrô và nhận dạng giọng nói trong Cài đặt để trò chuyện với CFO. Âm thanh không bao giờ rời khỏi điện thoại này."
          }
        }
      }
    },
    "Already accounted for": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jau paaiškinta"
          }
        },
        "vi": {
