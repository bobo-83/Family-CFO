    },
    "Restored. Reopen the app to see restored data.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atkurta. Iš naujo atidarykite programėlę, kad matytumėte atkurtus duomenis."
