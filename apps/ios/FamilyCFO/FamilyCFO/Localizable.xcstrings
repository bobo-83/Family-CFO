    },
    "How much of this account is untouchable savings that safe-to-spend holds back.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kokia šios sąskaitos dalis yra neliečiamos santaupos, kurių „Saugu išleisti“ neįskaičiuoja."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bao nhiêu trong tài khoản này là khoản tiết kiệm không được đụng tới mà An toàn để chi tiêu giữ lại."
          }
