            "value": "Kết thúc trò chuyện"
          }
        }
      }
    },
    "End date": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pabaigos data"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày kết thúc"
          }
        }
      }
    },
    "Enter as": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Įvesti kaip"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập theo"
          }
        }
      }
    },
    "Enter it as a positive number. An expense is stored as money out and a refund or payment received as money in — you never type a minus sign.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Įveskite teigiamą skaičių. Išlaidos įrašomos kaip išleisti pinigai, o grąžinimas ar gautas mokėjimas — kaip gauti pinigai; minuso ženklo vesti nereikia."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy nhập số dương. Khoản chi được lưu là tiền ra, còn khoản hoàn tiền hay tiền nhận được là tiền vào — bạn không bao giờ phải gõ dấu trừ."
          }
        }
      }
    },
    "Enter the end date, or — when the statement only says how many payments remain — the number of monthly payments left. Either way drives the payoff view.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Įveskite pabaigos datą arba — kai išraše nurodyta tik kiek įmokų liko — likusių mėnesio įmokų skaičių. Bet kuriuo atveju tai naudojama grąžinimo prognozei."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập ngày kết thúc, hoặc — khi bản sao kê chỉ ghi còn bao nhiêu kỳ trả — nhập số kỳ trả hằng tháng còn lại. Cách nào cũng dùng cho phần dự báo trả hết."
          }
        }
      }
    },
    "Enter the server address, e.g. 192.168.1.10:8443": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Įveskite serverio adresą, pvz., 192.168.1.10:8443"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập địa chỉ máy chủ, ví dụ 192.168.1.10:8443"
          }
        }
      }
    },
