    },
    "Versions differ, so screens may not match the server. Install the update from your box's OTA page.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Versijos skiriasi, tad ekranai gali neatitikti serverio. Įdiekite atnaujinimą iš serverio OTA puslapio."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản không khớp nên màn hình có thể khác với máy. Hãy cài bản cập nhật từ trang OTA của máy."
          }
        }
      }
    },
    "Vest date": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Įgijimo data"
          }
        },
        "vi": {
