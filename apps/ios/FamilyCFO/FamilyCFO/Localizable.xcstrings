            "state": "translated",
            "value": "Vai trò"
          }
        }
      }
    },
    "Rows marked declared are your family's own word, counted whether or not either account syncs.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eilutės, pažymėtos „nurodyta“, yra pačios jūsų šeimos nurodytos ir skaičiuojamos nepriklausomai nuo to, ar sąskaitos sinchronizuojamos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các dòng ghi tự khai là lời khai của chính gia đình bạn, được tính dù hai tài khoản có đồng bộ hay không."
          }
        }
      }
    },
    "Rows marked inferred were matched from the money leaving your account — the destination isn't synced.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eilutės, pažymėtos „numanoma“, atpažintos pagal pinigus, išeinančius iš jūsų sąskaitos — gavėjo sąskaita nesinchronizuojama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các dòng ghi suy đoán được khớp từ tiền rời khỏi tài khoản của bạn — nơi nhận không được đồng bộ."
          }
        }
      }
    },
