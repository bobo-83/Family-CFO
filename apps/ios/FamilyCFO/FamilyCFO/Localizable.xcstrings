    "Filled in automatically from an uploaded statement; set it here to override.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Užpildoma automatiškai iš įkelto išrašo; čia galite nurodyti savo reikšmę."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
