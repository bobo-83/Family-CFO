    "Its sessions end and its key to this household's data is destroyed. The phone itself is untouched.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jo seansai baigiami, o raktas į šio namų ūkio duomenis sunaikinamas. Pats telefonas lieka nepaliestas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phiên đăng nhập của nó kết thúc và khóa mở dữ liệu hộ gia đình bị hủy. Bản thân chiếc điện thoại không bị đụng tới."
          }
        }
      }
    },
    "Its transactions won't be deleted — they'll return to Uncategorized. Any budget for it is removed.": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jos operacijos nebus ištrintos — jos grįš į „Be kategorijos“. Jai skirtas biudžetas pašalinamas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch của nó sẽ không bị xóa — chúng quay về mục Chưa phân loại. Ngân sách của danh mục này sẽ bị gỡ bỏ."
          }
        }
      }
    },
    "Keep all — this is a real repeat": {
      "localizations": {
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Palikti visus — tai tikras pasikartojimas"
